{
  "name": "am-code-desktop",
  "productName": "AM Code",
  "desktopName": "am-code.desktop",
  "version": "0.4.0",
  "description": "AM Code desktop — agentic coding with your own models (Base URL + Model ID), an OpenCode-style checklist workflow and MCP support.",
  "author": "AM0_0dev",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "dev.amcode.desktop",
    "productName": "AM Code",
    "copyright": "Copyright © 2026 AM0_0dev",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "media/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "productVersion": "0.3.0"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "AM-Code-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AM Code",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AM-Code-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "artifactName": "AM-Code-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Araz0-0dev/am-code.git"
  },
  "homepage": "https://github.com/Araz0-0dev/am-code#readme",
  "bugs": {
    "url": "https://github.com/Araz0-0dev/am-code/issues"
  }
}
